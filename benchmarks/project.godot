; Bamboo benchmark suite. Run with misc/scripts/run_benchmarks.py.

config_version=5

[application]

config/name="BambooBenchmarks"
run/main_scene="res://main.tscn"
; Headless cannot draw, so the engine would otherwise sleep ~6.9 ms per frame (~144 FPS cap).
run/low_processor_mode_sleep_usec=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[physics]

3d/physics_engine="Jolt Physics"
