msgstr ""

#: modules/tilemap/editor/tile_set_atlas_source_editor.cpp:2471
msgid "The space (in tiles) between each frame of the animation."
msgstr ""

#: modules/tilemap/editor/tile_set_atlas_source_editor.cpp:2472
msgid "Animation speed in frames per second."
msgstr ""

#: modules/tilemap/editor/tile_set_atlas_source_editor.cpp:2473
msgid "Determines how animation will start. In \"Default\" mode all tiles start animating at the same frame. In \"Random Start Times\" mode, each tile starts animation with a random offset."
msgstr ""

#: modules/tilemap/editor/tile_set_atlas_source_editor.cpp:2474
msgid "If [code]true[/code], the tile is horizontally flipped."
msgstr ""

#: modules/tilemap/editor/tile_set_atlas_source_editor.cpp:2475
msgid "If [code]true[/code], the tile is vertically flipped."
msgstr ""

#: modules/tilemap/editor/tile_set_atlas_source_editor.cpp:2476
msgid "If [code]true[/code], the tile is rotated 90 degrees [i]counter-clockwise[/i] and then flipped vertically. In practice, this means that to rotate a tile by 90 degrees clockwise without flipping it, you should enable [b]Flip H[/b] and [b]Transpose[/b]. To rotate a tile by 180 degrees clockwise, enable [b]Flip H[/b] and [b]Flip V[/b]. To rotate a tile by 270 degrees clockwise, enable [b]Flip V[/b] and [b]Transpose[/b]."
msgstr ""

#: modules/tilemap/editor/tile_set_atlas_source_editor.cpp:2477
msgid "The origin to use for drawing the tile. This can be used to visually offset the tile compared to the base tile."
